# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed client origins
CLIENT_URL=http://localhost:3000

# MongoDB Atlas (include a database name, e.g. /classhub)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/classhub?retryWrites=true&w=majority&appName=Cluster0

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Sign-up: only these email domains (default gmail.com). Comma separated, or * for any email.
ALLOWED_EMAIL_DOMAINS=gmail.com
# New teachers must be approved by an admin (on). Set to off to skip verification (not recommended).
TEACHER_APPROVAL=on
# Create the first admin with:  npm run create-admin -- you@gmail.com "Your Name" yourPassword

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Public URL of the web app (used in emails and push notification links)
APP_URL=http://localhost:3000

# Web Push (phone notifications). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email for urgent notices (optional). Gmail: smtp.gmail.com, port 587, use an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ClassHub <you@gmail.com>

# File uploads: Cloudinary (free). Dashboard -> Product environment -> API keys.
# Leave empty to store files on this server's disk in UPLOAD_DIR instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=classhub
# Public URL of this API (used for locally stored files)
PUBLIC_API_URL=http://localhost:5000
MAX_UPLOAD_MB=10

# Time zone used for class reminders
TIMEZONE=Asia/Dhaka
# Set to "off" to stop automatic class reminders
REMINDERS=on
